# Cloudflare R2 Connection Configuration
# Retrieve these values from your Cloudflare Dashboard under R2 -> Manage R2 API Tokens
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=stat-stop-cache

# Optional FastF1 3.9 credentials for unattended token renewal.
# Alternatively, sign in using the same Python interpreter and OS user:
# python -m fastf1 auth f1tv --method browser --authenticate
# F1_USERNAME=your_email
# F1_PASSWORD=your_password
